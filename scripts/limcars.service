# LIMCARS — live inference observability (2 Hz sampler + SSE dash)
# Edit User= and WorkingDirectory= to match your install, then:
#   sudo cp scripts/limcars.service /etc/systemd/system/
#   sudo systemctl enable --now limcars

[Unit]
Description=LIMCARS live inference observability (2 Hz sampler + SSE dash)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/LIMCARS
ExecStart=/usr/bin/env bash /opt/LIMCARS/scripts/start.sh
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
